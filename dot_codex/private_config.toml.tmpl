#:schema https://developers.openai.com/codex/config-schema.json

web_search = "live"
default_permissions = ":danger-full-access"
approval_policy = "never"

model_reasoning_effort = "high"
plan_mode_reasoning_effort = "high"

[mcp_servers.context7]
url = "https://mcp.context7.com/mcp"
{{ with index . "context7_api_key" -}}
http_headers = { CONTEXT7_API_KEY = "{{ . }}" }
{{- end }}

[mcp_servers.gh_grep]
url = "https://mcp.grep.app"

{{ with index . "github_pat" -}}
[mcp_servers.github]
command = "npx"
args = ["-y", "@modelcontextprotocol/server-github"]
env = { GITHUB_PERSONAL_ACCESS_TOKEN = "{{ . }}" }
{{- end }}
{{ with index . "massive_api_key" -}}
[mcp_servers.massive]
command = "mcp_massive"
env = { MASSIVE_API_KEY = "{{ . }}" }
{{- end }}
{{ with index . "portfolio_arena_api_key" -}}
[mcp_servers.portfolio_arena]
url = "https://arena.kaufmann.dev/mcp"
http_headers = { Authorization = "Bearer {{ . }}" }
{{- end }}
{{ with index . "executive_arena_api_key" -}}
[mcp_servers.executive_arena]
url = "https://executives.kaufmann.dev/mcp"
http_headers = { Authorization = "Bearer {{ . }}" }
{{- end }}
{{ with index . "cv_resume_api_key" -}}
[mcp_servers.cv_resume]
url = "https://resume.kaufmann.dev/api/mcp"
http_headers = { Authorization = {{ printf "Bearer %s" . | toJson }} }
{{- end }}

{{ with index . "purelymail_accounts" -}}
[mcp_servers.purelymail]
command = "uvx"
args = ["mcp-email-server==1.9.0", "stdio"]
{{- end }}

[notice]
hide_full_access_warning = true
