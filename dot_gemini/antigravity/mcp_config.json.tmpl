{
  "mcpServers": {
    "context7": {
      "serverUrl": "https://mcp.context7.com/mcp"
    },
    "gh_grep": {
      "serverUrl": "https://mcp.grep.app"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--browser",
        "chromium"
      ]
    }{{ with index . "github_pat" }},
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{{ . }}"
      }
    }
    {{- end }}{{ with index . "massive_api_key" }},
    "massive": {
      "command": "mcp_massive",
      "env": {
        "MASSIVE_API_KEY": "{{ . }}"
      }
    }
    {{- end }}{{ with index . "portfolio_arena_api_key" }},
    "portfolio_arena": {
      "serverUrl": "https://arena.kaufmann.dev/mcp",
      "headers": {
        "Authorization": "Bearer {{ . }}"
      }
    }
    {{- end }}
  }
}
