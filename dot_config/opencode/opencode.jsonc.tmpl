{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "default_agent": "build",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }{{ with index . "github_pat" }},
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {{ . }}"
      }
    }
    {{- end }}{{ with index . "massive_api_key" }},
    "massive": {
      "type": "local",
      "command": [
        "mcp_massive"
      ],
      "environment": {
        "MASSIVE_API_KEY": "{{ . }}"
      }
    }
    {{- end }}{{ with index . "portfolio_arena_api_key" }},
    "portfolio_arena": {
      "type": "remote",
      "url": "https://arena.kaufmann.dev/mcp",
      "headers": {
        "Authorization": "Bearer {{ . }}"
      }
    }
    {{- end }}
  },
  "tools": {
    "websearch": true,
    "codesearch": true
  }
}
