{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "default_agent": "build",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"{{ with index . "context7_api_key" }},
      "headers": {
        "CONTEXT7_API_KEY": "{{ . }}"
      }{{- end }}
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }{{ with index . "github_pat" }},
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{{ . }}"
      }
    }
    {{- end }}{{ with index . "massive_api_key" }},
    "massive": {
      "type": "local",
      "command": [
        "mcp_massive"
      ],
      "environment": {
        "MASSIVE_API_KEY": "{{ . }}"
      }
    }
    {{- end }}{{ with index . "portfolio_arena_api_key" }},
    "portfolio_arena": {
      "type": "remote",
      "url": "https://arena.kaufmann.dev/mcp",
      "headers": {
        "Authorization": "Bearer {{ . }}"
      }
    }
    {{- end }}{{ with index . "executive_arena_api_key" }},
    "executive_arena": {
      "type": "remote",
      "url": "https://executives.kaufmann.dev/mcp",
      "headers": {
        "Authorization": "Bearer {{ . }}"
      }
    }
    {{- end }}
  },
  "tools": {
    "websearch": true,
    "codesearch": true
  }
}
