{
  "schema_version": 1,
  "mcpServers": {
    "context7": {
      "type": "streamable-http",
      "url": "https://mcp.context7.com/mcp"{{ with index . "context7_api_key" }},
      "headers": {
        "CONTEXT7_API_KEY": "{{ . }}"
      }{{- end }},
      "mode": "optional"
    },
    "gh_grep": {
      "type": "streamable-http",
      "url": "https://mcp.grep.app",
      "mode": "optional"
    }{{ with index . "github_pat" }},
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{{ . }}"
      },
      "mode": "optional"
    }
    {{- end }}{{ with index . "massive_api_key" }},
    "massive": {
      "type": "stdio",
      "command": "mcp_massive",
      "env": {
        "MASSIVE_API_KEY": "{{ . }}"
      },
      "mode": "optional"
    }
    {{- end }}{{ with index . "portfolio_arena_api_key" }},
    "portfolio_arena": {
      "type": "streamable-http",
      "url": "https://arena.kaufmann.dev/mcp",
      "headers": {
        "Authorization": "Bearer {{ . }}"
      },
      "mode": "optional"
    }
    {{- end }}{{ with index . "executive_arena_api_key" }},
    "executive_arena": {
      "type": "streamable-http",
      "url": "https://executives.kaufmann.dev/mcp",
      "headers": {
        "Authorization": "Bearer {{ . }}"
      },
      "mode": "optional"
    }
    {{- end }}{{ with index . "cv_resume_api_key" }},
    "cv_resume": {
      "type": "streamable-http",
      "url": "https://resume.kaufmann.dev/api/mcp",
      "headers": {
        "Authorization": {{ printf "Bearer %s" . | toJson }}
      },
      "mode": "optional"
    }
    {{- end }}{{ with index . "purelymail_accounts" }},
    "purelymail": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-email-server==1.9.0",
        "stdio"
      ],
      "mode": "optional"
    }
    {{- end }}
  }
}
