#!/bin/sh
set -eu

source_line='source ~/.config/shell/agent-aliases.sh'
temporary_file=$(mktemp)
trap 'rm -f "$temporary_file"' EXIT HUP INT TERM

cat > "$temporary_file"
cat "$temporary_file"
if ! grep -Fqx "$source_line" "$temporary_file"; then
  if [ -s "$temporary_file" ]; then
    printf '\n'
  fi
  printf '%s\n' "$source_line"
fi
