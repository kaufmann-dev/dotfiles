{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"{{ with index . "context7_api_key" }},
      "headers": {
        "CONTEXT7_API_KEY": "{{ . }}"
      }{{- end }}
    },
    "gh_grep": {
      "type": "http",
      "url": "https://mcp.grep.app"
    }{{ with index . "github_pat" }},
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{{ . }}"
      }
    }
    {{- end }}{{ with index . "massive_api_key" }},
    "massive": {
      "type": "stdio",
      "command": "mcp_massive",
      "env": {
        "MASSIVE_API_KEY": "{{ . }}"
      }
    }
    {{- end }}{{ with index . "portfolio_arena_api_key" }},
    "portfolio_arena": {
      "type": "http",
      "url": "https://arena.kaufmann.dev/mcp",
      "headers": {
        "Authorization": "Bearer {{ . }}"
      }
    }
    {{- end }}
  }
}
